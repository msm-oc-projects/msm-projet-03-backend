# Copier ce fichier vers .env et remplacer toutes les valeurs de démonstration.
# Ne jamais versionner le fichier .env réel.
MYSQL_ROOT_PASSWORD=remplacer_par_un_secret_root_local
MYSQL_PASSWORD=remplacer_par_un_secret_applicatif

# Générer avec : openssl rand -base64 48
JWT_SECRET=remplacer_par_un_secret_jwt_base64
JWT_ISSUER=chatop-api
JWT_EXPIRATION=PT24H

# Ports liés uniquement à l'interface locale 127.0.0.1.
MYSQL_PORT=3306
PHPMYADMIN_PORT=8081
SERVER_PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE=5MB
